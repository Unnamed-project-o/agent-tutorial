a507-4b35-a305-5f343333b8d3", "node_type": "1", "metadata": {}, "hash": "4f8a3093c697141245acfe0b134de5adb39ebc66beb9af539c73c43dda87697c", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Q: DS\u662f\u4ec0\u4e48\uff1f\nA: DS\u662f\u6570\u636e\u7ed3\u6784\uff08Data Structure\uff09\u7684\u7f29\u5199\uff0c\u662f\u8ba1\u7b97\u673a\u79d1\u5b66\u4e2d\u7684\u4e00\u4e2a\u91cd\u8981\u6982\u5ff5\uff0c\u7528\u4e8e\u7ec4\u7ec7\u548c\u5b58\u50a8\u6570\u636e\uff0c\u4ee5\u4fbf\u9ad8\u6548\u5730\u8bbf\u95ee\u548c\u4fee\u6539\u3002\u5e38\u89c1\u7684\u6570\u636e\u7ed3\u6784\u5305\u62ec\u6570\u7ec4\u3001\u94fe\u8868\u3001\u6808\u3001\u961f\u5217\u3001\u6811\u3001\u56fe\u7b49\u3002\u5b66\u4e60\u6570\u636e\u7ed3\u6784\u53ef\u4ee5\u5e2e\u52a9\u6211\u4eec\u66f4\u597d\u5730\u7406\u89e3\u7b97\u6cd5\u7684\u5b9e\u73b0\u548c\u4f18\u5316\uff0c\u63d0\u9ad8\u7f16\u7a0b\u80fd\u529b\u3002\n\nQ: \u63a8\u8350\u5b66\u4e60DS\u7684\u8d44\u6e90\u3002\nA: \u5b66\u4e60\u6570\u636e\u7ed3\u6784\u7684\u8d44\u6e90\u6709\u5f88\u591a\uff0c\u4ee5\u4e0b\u662f\u4e00\u4e9b\u63a8\u8350\u7684\u8d44\u6e90\uff1a\n   1. \u4e66\u7c4d\uff1a\n      - \u300a\u7b97\u6cd5\u5bfc\u8bba\u300b\uff08Introduction to Algorithms\uff09 by Thomas H. Cormen, Charles E. Leiserson, Ronald L. Rivest, Clifford Stein\n      - \u300a\u6570\u636e\u7ed3\u6784\u4e0e\u7b97\u6cd5\u5206\u6790\u300b\uff08Data Structures and Algorithm Analysis\uff09 by Mark Allen Weiss\n      - \u300a\u7b97\u6cd5\u300b\uff08Algorithms\uff09 by Robert Sedgewick, Kevin Wayne\n   2.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 450, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "ff366155-a507-4b35-a305-5f343333b8d3": {"__data__": {"id_": "ff366155-a507-4b35-a305-5f343333b8d3", "embedding": null, "metadata": {"file_path": "/Users/jackhu/src_code/ai-infra-agent/agent-tutorial/resource/ds.txt", "file_name": "ds.txt", "file_type": "text/plain", "file_size": 3286, "creation_date": "2026-05-30", "last_modified_date": "2026-06-02"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "fa2081bc-e68c-45d7-ab9d-ab7f586d4ff5", "node_type": "4", "metadata": {"file_path": "/Users/jackhu/src_code/ai-infra-agent/agent-tutorial/resource/ds.txt", "file_name": "ds.txt", "file_type": "text/plain", "file_size": 3286, "creation_date": "2026-05-30", "last_modified_date": "2026-06-02"}, "hash": "9196b8697119accb98cef31029b2a06e2d2bfc6a9ee07889ecbd5f30b89d5e2b", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "3284fd82-797e-44d9-8705-3286a372b841", "node_type": "1", "metadata": {"file_path": "/Users/jackhu/src_code/ai-infra-agent/agent-tutorial/resource/ds.txt", "file_name": "ds.txt", "file_type": "text/plain", "file_size": 3286, "creation_date": "2026-05-30", "last_modified_date": "2026-06-02"}, "hash": "1d69c0ce0554fbb9274f44eccb2fe37a0323922f5c1a5b098204e071d3e8e49e", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u5728\u7ebf\u8bfe\u7a0b\uff1a\n      - Coursera\u4e0a\u7684\u300a\u6570\u636e\u7ed3\u6784\u4e0e\u7b97\u6cd5\u300b\u8bfe\u7a0b by Princeton University\n      - edX\u4e0a\u7684\u300a\u6570\u636e\u7ed3\u6784\u4e0e\u7b97\u6cd5\u300b\u8bfe\u7a0b by University of California, San Diego\n      - Udacity\u4e0a\u7684\u300a\u6570\u636e\u7ed3\u6784\u4e0e\u7b97\u6cd5\u300b\u8bfe\u7a0b by Georgia Tech\n\nQ: \u96f6\u57fa\u7840\u5b66\u4e60 DS \u5e94\u8be5\u6309\u7167\u4ec0\u4e48\u987a\u5e8f\u6765\uff1f\nA: \u5efa\u8bae\u9075\u5faa\u201c\u7531\u6d45\u5165\u6df1\u3001\u5148\u7ebf\u6027\u540e\u975e\u7ebf\u6027\u201d\u7684\u8def\u5f84\u3002\u7b2c\u4e00\u9636\u6bb5\u5148\u638c\u63e1\u57fa\u7840\u7ebf\u6027\u7ed3\u6784\uff0c\u5305\u62ec\u6570\u7ec4\u3001\u94fe\u8868\u3001\u6808\u548c\u961f\u5217\uff0c\u7406\u89e3\u5b83\u4eec\u5728\u5185\u5b58\u4e2d\u7684\u5b58\u50a8\u65b9\u5f0f\uff1b\u7b2c\u4e8c\u9636\u6bb5\u8fdb\u9636\u5230\u6811\u5f62\u7ed3\u6784\u548c\u54c8\u5e0c\u8868\uff0c\u91cd\u70b9\u653b\u514b\u4e8c\u53c9\u6811\u7684\u904d\u5386\u4e0e\u5806\u7684\u7279\u6027\uff1b\u7b2c\u4e09\u9636\u6bb5\u518d\u6311\u6218\u56fe\u8bba\u7b49\u590d\u6742\u7ed3\u6784\u3002\u540c\u65f6\uff0c\u7b97\u6cd5\u7684\u5b66\u4e60\u4e5f\u8981\u540c\u6b65\u7a7f\u63d2\uff0c\u4ece\u57fa\u7840\u7684\u6392\u5e8f\u3001\u67e5\u627e\u7b97\u6cd5\u5f00\u59cb\uff0c\u9010\u6b65\u8fc7\u6e21\u5230\u9012\u5f52\u3001\u5206\u6cbb\u3001\u8d2a\u5fc3\u4ee5\u53ca\u52a8\u6001\u89c4\u5212\u7b49\u6838\u5fc3\u601d\u60f3\u3002\n\nQ: \u5b66\u4e60\u6570\u636e\u7ed3\u6784\u65f6\uff0c\u770b\u4e66\u5c31\u591f\u4e86\u5417\uff1f\nA: \u8fdc\u8fdc\u4e0d\u591f\u3002\u6570\u636e\u7ed3\u6784\u548c\u7b97\u6cd5\u662f\u201c\u7ec3\u4f1a\u201d\u7684\uff0c\u7edd\u4e0d\u662f\u5355\u7eaf\u201c\u770b\u61c2\u201d\u7684\u3002\u5728\u5b66\u4e60\u6bcf\u4e2a\u77e5\u8bc6\u70b9\u65f6\uff0c\u4e00\u5b9a\u8981\u4eb2\u81ea\u52a8\u624b\u5199\u4ee3\u7801\uff0c\u4ece\u96f6\u5b9e\u73b0\u4e00\u904d\u6838\u5fc3\u7ed3\u6784\uff08\u6bd4\u5982\u624b\u52a8\u5199\u4e00\u4e2a\u94fe\u8868\u7684\u589e\u5220\u6539\u67e5\uff09\u3002\u7406\u8bba\u7ed3\u5408\u5b9e\u8df5\u540e\uff0c\u9700\u8981\u53bb LeetCode \u6216\u725b\u5ba2\u7f51\u7b49\u5e73\u53f0\u8fdb\u884c\u9488\u5bf9\u6027\u7684\u5237\u9898\u7ec3\u4e60\u3002\u5efa\u8bae\u6309\u6807\u7b7e\u5206\u7c7b\u5237\u9898\uff0c\u4ece\u7b80\u5355\u9898\u5f00\u59cb\u5efa\u7acb\u4fe1\u5fc3\uff0c\u9047\u5230\u4e0d\u4f1a\u7684\u9898\u76ee\u53ca\u65f6\u590d\u76d8\uff0c\u5e76\u5c1d\u8bd5\u7528\u591a\u79cd\u89e3\u6cd5\u53bb\u4f18\u5316\u81ea\u5df1\u7684\u4ee3\u7801\u3002\n\nQ: \u611f\u89c9\u8bfe\u672c\u4e0a\u7684\u6982\u5ff5\u592a\u62bd\u8c61\uff0c\u6709\u4ec0\u4e48\u8f85\u52a9\u7406\u89e3\u7684\u65b9\u6cd5\u5417\uff1f\nA: \u5f3a\u70c8\u63a8\u8350\u5229\u7528\u53ef\u89c6\u5316\u5de5\u5177\u6765\u6253\u7834\u62bd\u8c61\u611f\u3002\u4f60\u53ef\u4ee5\u4f7f\u7528 VisuAlgo \u7b49\u5728\u7ebf\u7f51\u7ad9\uff0c\u76f4\u89c2\u5730\u770b\u5230\u6570\u636e\u63d2\u5165\u3001\u5220\u9664\u3001\u904d\u5386\u7684\u52a8\u6001\u8fc7\u7a0b\uff0c\u8fd9\u6bd4\u6b7b\u8bb0\u786c\u80cc\u5b9a\u4e49\u6709\u6548\u5f97\u591a\u3002\u6b64\u5916\uff0c\u517b\u6210\u201c\u7eb8\u7b14\u63a8\u6f14\u201d\u7684\u4e60\u60ef\u4e5f\u975e\u5e38\u91cd\u8981\uff0c\u5728\u5199\u4ee3\u7801\u524d\u5148\u5728\u7eb8\u4e0a\u753b\u51fa\u6570\u636e\u7684\u903b\u8f91\u7ed3\u6784\u3001\u6307\u9488\u7684\u6307\u5411\u53d8\u5316\uff0c\u6216\u8005\u753b\u51fa\u601d\u7ef4\u5bfc\u56fe\u6765\u4e32\u8054\u96f6\u6563\u7684\u77e5\u8bc6\u70b9\uff0c\u80fd\u6781\u5927\u63d0\u5347\u4f60\u7684\u7406\u89e3\u548c\u8bb0\u5fc6\u6df1\u5ea6\u3002\n\nQ: \u5b66\u4e86\u5f88\u591a\u6570\u636e\u7ed3\u6784\uff0c\u4f46\u505a\u9898\u65f6\u4e0d\u77e5\u9053\u600e\u4e48\u9009\u7528\u600e\u4e48\u529e\uff1f\nA: \u8fd9\u662f\u56e0\u4e3a\u8fd8\u6ca1\u6709\u5efa\u7acb\u8d77\u201c\u573a\u666f\u5316\u601d\u7ef4\u201d\u3002\u5728\u5b66\u4e60\u6bcf\u79cd\u7ed3\u6784\u65f6\uff0c\u4e0d\u4ec5\u8981\u61c2\u539f\u7406\uff0c\u66f4\u8981\u523b\u610f\u53bb\u603b\u7ed3\u5b83\u7684\u9002\u7528\u573a\u666f\u548c\u4f18\u7f3a\u70b9\u3002\u4f8b\u5982\uff0c\u9700\u8981\u9891\u7e41\u968f\u673a\u8bbf\u95ee\u6570\u636e\u65f6\u4f18\u5148\u9009\u6570\u7ec4\uff0c\u800c\u9700\u8981\u9891\u7e41\u63d2\u5165\u5220\u9664\u5219\u8003\u8651\u94fe\u8868\uff1b\u5904\u7406\u5c42\u7ea7\u5173\u7cfb\u6216\u8868\u8fbe\u5f0f\u89e3\u6790\u65f6\u7528\u6811\uff0c\u89e3\u51b3\u6700\u77ed\u8def\u5f84\u6216\u793e\u4ea4\u7f51\u7edc\u95ee\u9898\u5219\u79bb\u4e0d\u5f00\u56fe\u3002\u5e73\u65f6\u591a\u53bb\u601d\u8003\u771f\u5b9e\u5de5\u7a0b\u9879\u76ee\uff08\u5982\u6570\u636e\u5e93\u7d22\u5f15\u3001\u641c\u7d22\u5f15\u64ce\uff09\u4e2d\u662f\u5982\u4f55\u5e94\u7528\u8fd9\u4e9b\u7ed3\u6784\u7684\uff0c\u6162\u6162\u5c31\u80fd\u57f9\u517b\u51fa\u201c\u7528\u4ec0\u4e48\u5de5\u5177\u89e3\u51b3\u4ec0\u4e48\u95ee\u9898\u201d\u7684\u76f4\u89c9\u3002", "mimetype": "text/plain", "start_char_idx": 451, "end_char_idx": 1404, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}